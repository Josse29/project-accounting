{
  "type": "module",
  "name": "josstack",
  "version": "1.0.0",
  "description": "elevate your company with us",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "watch": "electronmon .",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.example.app",
    "productName": "Josstack",
    "directories": {
      "buildResources": "icon"
    },
    "files": [
      "src/client-side/**/*",
      "src/serverless-side/**/*",
      "main.js",
      "preload.js"
    ],
    "win": {
      "target": [
        "zip",
        "nsis"
      ],
      "icon": "icon/josstack.ico"
    }
  },
  "author": "josse",
  "license": "ISC",
  "devDependencies": {
    "electron": "^30.0.1",
    "electron-builder": "^26.0.12",
    "electronmon": "^2.0.3"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^6.7.2",
    "bcryptjs": "^3.0.2",
    "bootstrap": "^5.3.5",
    "jsonwebtoken": "^9.0.2",
    "sqlite3": "^5.1.7"
  }
}
