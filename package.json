{
  "type": "module",
  "name": "cozy-accounting",
  "version": "1.0.0",
  "description": "elevate your company with us",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "watch": "electronmon .",
    "dist": "electron-builder",
    "build:win": "electron-builder --win nsis",
    "build:mac": "electron-builder --mac dmg",
    "build:linux": "electron-builder --linux AppImage deb"
  },
  "build": {
    "appId": "com.josse.cozyaccounting",
    "productName": "Cozy Accounting",
    "directories": {
      "buildResources": "icon"
    },
    "extraResources": [
      {
        "from": "assets",
        "to": "assets"
      }
    ],
    "files": [
      "src/**/*",
      "main.js",
      "preload.js"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "icon/josstack.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": true
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "icon/josstack.icns",
      "category": "public.app-category.finance"
    },
    "dmg": {
      "background": "icon/dmg-background.png",
      "iconSize": 100,
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "icon",
      "category": "Finance"
    }
  },
  "author": "josse",
  "license": "ISC",
  "devDependencies": {
    "electron": "^30.0.1",
    "electron-builder": "^26.0.12",
    "electronmon": "^2.0.3"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "jsonwebtoken": "^9.0.2",
    "sqlite3": "^5.1.7"
  }
}
